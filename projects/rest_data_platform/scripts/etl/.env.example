# Lokale Supabase (nach pnpm supabase:web:start)
# Port 54330 vermeidet Konflikte mit lokalem IB Gateway / TWS.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54330/postgres

# Cloud IMC (service_role — nur ETL, nie im Browser)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Pfad zu 4C-Samples (nicht ins Repo committen)
FOURC_SAMPLE_DIR=C:/Users/he5013/academiccloudsync/ASTRA_Maritime_Circularity/02_Data/Reference_Data

# Optional: echter MaStR-CSV (Erweiterte Einheitenübersicht, Wind/See)
# MASTR_CSV_PATH=C:/Users/he5013/academiccloudsync/ASTRA_Maritime_Circularity/02_Data/Reference_Data/mastr_einheiten_wind_see.csv

# MaStR Gesamtdatenexport-Ausschnitt (UTF-16 XML)
MASTR_XML_DIR=C:/Users/he5013/academiccloudsync/ASTRA_Maritime_Circularity/02_Data/Extraction/MaStR

# Tenant für ETL (Team-Account UUID aus public.accounts)
IMC_ETL_ACCOUNT_ID=
